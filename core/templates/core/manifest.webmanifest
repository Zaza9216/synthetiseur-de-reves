{% load static %}{
  "name": "Synthétiseur de rêves",
  "short_name": "Rêves",
  "description": "Racontez vos rêves à voix haute : transcription, émotion et illustration.",
  "lang": "fr",
  "start_url": "/reves/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#07061a",
  "theme_color": "#0d0b26",
  "icons": [
    {"src": "{% static 'icons/icon-192.png' %}", "sizes": "192x192", "type": "image/png"},
    {"src": "{% static 'icons/icon-512.png' %}", "sizes": "512x512", "type": "image/png"},
    {"src": "{% static 'icons/icon-maskable-512.png' %}", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "shortcuts": [
    {"name": "Raconter un rêve", "url": "/reves/nouveau/", "icons": [{"src": "{% static 'icons/icon-192.png' %}", "sizes": "192x192"}]}
  ]
}
