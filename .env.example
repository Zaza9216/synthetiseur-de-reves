# Copier ce fichier en .env puis remplir les valeurs.
# Ne JAMAIS committer le fichier .env.

# Clé secrète Django (générer avec : uv run python -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
LOG_LEVEL=INFO

# Laisser vide en local (SQLite). En production : postgres://user:password@host:5432/dbname
DATABASE_URL=
