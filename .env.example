# Copier ce fichier en .env puis remplir les valeurs.
# Ne JAMAIS committer le fichier .env.

# Clé secrète Django (générer avec : uv run python -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
LOG_LEVEL=INFO

# Laisser vide en local (SQLite). En production : postgres://user:password@host:5432/dbname
DATABASE_URL=

# --- Services d'IA ---
# Clé OpenAI (transcription, émotion, image) : https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Modèle de transcription (voir docs/journal-de-bord.md pour le comparatif)
TRANSCRIPTION_MODEL=gpt-4o-transcribe

# --- Traitement des rêves ---
# thread (arrière-plan, recommandé) | sync (dans la requête, débogage) | off (désactivé)
DREAM_PROCESSING_MODE=thread
# Nombre maximal de rêves par utilisateur et par jour
DREAM_DAILY_LIMIT=10
# Génération d'image : modèle, qualité (low | medium | high)
IMAGE_MODEL=gpt-image-1-mini
IMAGE_QUALITY=medium
# Plafond de dépenses IA par mois, en dollars (budget projet : 20 €)
AI_MONTHLY_BUDGET_USD=15

# --- Supervision ---
# text (lisible, en local) | json (une ligne JSON par événement, en production)
LOG_FORMAT=text
# Seuil (ms) au-delà duquel une requête est journalisée comme lente
SLOW_REQUEST_MS=1000
# Suivi des erreurs Sentry (facultatif) : https://sentry.io
SENTRY_DSN=
